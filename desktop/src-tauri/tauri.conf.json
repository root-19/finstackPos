{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "FinstackPOS",
    "version": "0.3.0",
    "identifier": "com.finstackpos.desktop",
    "build": {
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "createUpdaterArtifacts": true,
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
        "windows": {
            "webviewInstallMode": { "type": "downloadBootstrapper" },
            "nsis": { "installMode": "perMachine" }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwODMyODM0NkMyMEE1NjcKUldSbnBTQnNOQ2lEb0FxRDRoS00xZmh4UG9pcElNaWUrWlZyU3A5VkduQk96TnV1S2dleVUxajcK",
            "endpoints": ["https://finstackpos.shop/desktop/update/{{target}}/{{arch}}/{{current_version}}"],
            "windows": { "installMode": "passive" }
        }
    }
}
