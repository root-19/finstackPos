<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

# Block direct access to sensitive files (.env, .git, composer files, etc.)
<FilesMatch "^\.|^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.ts|vitest\.config\.ts|tsconfig\.json|tailwind\.config\.js|postcss\.config\.js|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block app folders that must never be served directly. Not `storage`: /storage/... is the public
    # uploads link (product photos, store QR); the rule below sends it to public/storage, which only
    # points at storage/app/public, so logs and the rest of storage/ stay unreachable.
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|tests|vendor|\.git|\.claude|\.10x)(/|$) - [F,L]

    # Send everything to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
